# 和风中继的配置（systemd 用 EnvironmentFile 读它）
# 装到 /etc/wx-relay.env，权限设 600 —— 里面有凭据。
#
#   cp wx-relay.env.example /etc/wx-relay.env && chmod 600 /etc/wx-relay.env
#   vi /etc/wx-relay.env        # 把下面几行按你的实际情况改掉
#   systemctl restart wx-relay

# 监听端口（ESP32 那边 WX_RELAY_URL 里的端口要对上）
WX_RELAY_PORT=8788
WX_RELAY_BIND=0.0.0.0

# —— 和风的 API Host（控制台 → 设置 里那串，形如 xxx.xx.qweatherapi.com）——
QWEATHER_HOST=kj4bjd22dq.re.qweatherapi.com

# —— JWT 三项 + 私钥（推荐；私钥就是 keygen 生成的 ed25519-private.pem）——
QWEATHER_JWT_KID=KMWDYQGERV
QWEATHER_JWT_SUB=29TNG35JCC
QWEATHER_DEV_ID=Q92D603497
QWEATHER_JWT_KEY=/opt/wx-relay/ed25519-private.pem

# 不想折腾 JWT 也可以只用 API key（安全性差些，key 泄露即长期可用）：
# QWEATHER_KEY=你的key

# 坐标（默认深圳公明广场）与缓存秒数
WX_RELAY_LAT=22.7809
WX_RELAY_LON=113.8861
WX_RELAY_CACHE=120
